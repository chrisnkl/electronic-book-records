FROM jenkins/jenkins:lts

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    docker.io \
    python3 \
    python3-pip \
    nmap \
    sqlmap \
    curl \
    git && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install semgrep zapcli --break-system-packages

USER jenkins